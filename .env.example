# Genie API Gateway 통합 환경설정 예제
# 복사: cp .env.example .env
# 기본 활성 예시는 온프레미스/일반 PostgreSQL 구성이다.
# Secret 원문이 포함된 .env는 Git에 커밋하지 않는다.

APP_NAME=Genie API Gateway
APP_VERSION=0.1.0
APP_ENV=onprem
LOG_LEVEL=INFO
DOCS_ENABLED=true

CUSTOM_CHAT_UI_ENABLED=true
CUSTOM_CHAT_LOCAL_ONLY=false
ADMIN_UI_ENABLED=true
ADMIN_SESSION_TTL_SECONDS=28800
# 프록시 이메일 인증을 사용할 때만 지정한다.
ADMIN_BOOTSTRAP_EMAIL=

# POSTGRES: DATABASE_URL 사용
DATABASE_MODE=POSTGRES
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@<db_host>:5432/<db_name>
DATABASE_SCHEMA=genie_gw

# RDS/RDS_IAM/LAKEBASE는 DATABASE_URL 대신 다음 표준 PG 변수를 사용한다.
# PGHOST=<database-host>
# PGPORT=5432
# PGDATABASE=<database-name>
# PGUSER=<database-user>
# PGPASSWORD=<database-password>       # RDS 비밀번호 인증에서만 사용
# PGSSLMODE=verify-full
# PGSSLROOTCERT=<ca-certificate-path>

# Amazon RDS 선택 설정
# DATABASE_MODE=RDS_IAM
# AWS_REGION=ap-northeast-2
# RDS_SECRET_REF=<secrets-manager-secret-id>  # DATABASE_MODE=RDS 대안

# Databricks Apps + Lakebase 선택 설정
# DATABASE_MODE=LAKEBASE
# LAKEBASE_ENDPOINT=<lakebase-endpoint-name>
# PGHOST/PGPORT/PGDATABASE/PGUSER/PGSSLMODE와 Databricks 인증값은 App Resource가 주입한다.

GATEWAY_AUTH_MODE=API_KEY
DATABRICKS_HOST=https://<workspace-host>
# 운영에서는 OAuth M2M 또는 배포 플랫폼의 Secret 주입을 사용한다.
DATABRICKS_CLIENT_ID=<service-principal-client-id>
DATABRICKS_CLIENT_SECRET=<service-principal-client-secret>
# 개발·검증에서만 PAT를 대안으로 사용할 수 있다.
# DATABRICKS_TOKEN=<personal-access-token>

# Admin Web에서 API Key 원문을 복구해야 하는 경우 필요한 32-byte URL-safe Base64 키
API_KEY_ENCRYPTION_KEY=<URL_SAFE_BASE64_32_BYTE_KEY>

AUDIT_PAYLOADS=false
ALLOW_INSECURE_UPSTREAM=false
UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
UPSTREAM_READ_TIMEOUT_SECONDS=1860
UPSTREAM_RETRY_ATTEMPTS=2
SUPERVISOR_GATEWAY_MAX_ACTIVE_RUNS=40
SUPERVISOR_USER_MAX_ACTIVE_RUNS=10
SUPERVISOR_USER_AGENT_MAX_ACTIVE_RUNS=5

# 로컬 개발 전용 인증 우회. 운영 환경에서는 설정하지 않는다.
# GATEWAY_DEV_TOKEN=<development-token>
# GATEWAY_DEV_SYSTEM_CD=<system-code>
# GATEWAY_DEV_CLIENT_CD=<client-code>
