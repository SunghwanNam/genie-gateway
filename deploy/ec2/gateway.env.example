APP_NAME=Genie API Gateway
APP_VERSION=0.1.0
APP_ENV=production
LOG_LEVEL=INFO
DOCS_ENABLED=false

CUSTOM_CHAT_UI_ENABLED=false
CUSTOM_CHAT_LOCAL_ONLY=true
ADMIN_UI_ENABLED=true
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_BOOTSTRAP_EMAIL=

DATABASE_MODE=POSTGRES
DATABASE_URL=postgresql+asyncpg://genie_gateway:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/genie_gateway
DATABASE_SCHEMA=genie_gw

GATEWAY_AUTH_MODE=API_KEY

DATABRICKS_HOST=https://CHANGE_ME_WORKSPACE_HOST
DATABRICKS_CLIENT_ID=CHANGE_ME_GATEWAY_SP_APPLICATION_ID
DATABRICKS_CLIENT_SECRET=CHANGE_ME_GATEWAY_SP_OAUTH_SECRET

API_KEY_ENCRYPTION_KEY=CHANGE_ME_URL_SAFE_BASE64_32_BYTE_KEY

AUDIT_PAYLOADS=false
ALLOW_INSECURE_UPSTREAM=false
UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
UPSTREAM_READ_TIMEOUT_SECONDS=1860
UPSTREAM_RETRY_ATTEMPTS=2

UVICORN_HOST=0.0.0.0
UVICORN_PORT=38085
